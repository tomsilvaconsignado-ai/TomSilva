# Supabase Configuration
# Obtenha em seu painel: Project Settings -> API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-aqui"

# Gemini AI (se necessário para sumarização de notícias)
GEMINI_API_KEY=""

# URL do portal
APP_URL="https://folhadaregiaonline.com.br"

# Servidor de API opcional (server.ts). No GitHub Pages ele não existe e as funções
# que dependem dele (e-mails personalizados, teste SMTP) ficam desativadas.
# Se hospedar o server.ts (Render, Railway, VPS...), informe a URL dele no build.
# Use "/" quando o próprio server.ts servir o site (npm run build && npm start).
VITE_API_BASE_URL=""

# Chave service_role: SOMENTE no servidor, nunca em variável VITE_ (iria para o navegador)
SUPABASE_SERVICE_ROLE_KEY=""

# Configurações de E-mail do Portal / SMTP (Opcional - também configurável pelo Painel Administrativo)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Folha da Região"
SMTP_FROM_EMAIL="contato@folhadaregiaoonline.com.br"
SMTP_SECURE="false"
# Aceitar certificado TLS inválido no SMTP (apenas servidor próprio de testes)
SMTP_ALLOW_INVALID_CERT="false"
